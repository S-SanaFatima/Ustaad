<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
</IfModule>

<IfModule mod_headers.c>
  # HSTS — 2 years, subdomains, preload-eligible
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://translate.google.com https://translate.googleapis.com https://translate-pa.googleapis.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://www.gstatic.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https://www.googletagmanager.com https://translate.googleapis.com https://translate-pa.googleapis.com; frame-src https://translate.googleapis.com https://translate.google.com; frame-ancestors 'none';"

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Content-Type "text/html; charset=utf-8"
  </FilesMatch>

  <FilesMatch "\.(js|mjs|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(png|jpg|jpeg|webp|svg|ico|gif)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

# Custom 404 page (HTTP status remains 404)
ErrorDocument 404 /404.html

# Stop Apache auto-redirecting /about → /about/ before our rules run.
DirectorySlash Off

RewriteEngine On
RewriteBase /

# --- Canonical host & protocol (single 301 hop) ---
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

# --- Duplicate / legacy slugs → canonical (301) ---
RewriteRule ^apply-now/?$ /contact [R=301,L]
RewriteRule ^british/?$ /british-curriculum [R=301,L]
RewriteRule ^sat-emsat/?$ /exam-preparation [R=301,L]
RewriteRule ^gcse-cbse/?$ /gcse [R=301,L]
RewriteRule ^mathematics/?$ /maths [R=301,L]
RewriteRule ^mathtestlanding/?$ /maths-tutor-abu-dhabi [R=301,L]
RewriteRule ^faqs/?$ /#faqs [R=301,L,NE]

# --- WordPress-era URLs: HTTP 410 Gone ---
RewriteRule ^author(/.*)?$ - [G,L]
RewriteRule ^category(/.*)?$ - [G,L]
RewriteRule ^elementor-hf(/.*)?$ - [G,L]
RewriteRule ^[0-9]{4}/[0-9]{2}/[0-9]{2}(/.*)?$ - [G,L]

RewriteRule ^School%20logos/(.*)$ /school-logos/$1 [R=301,L]

# Real files (JS, CSS, images, direct .html) → serve as-is
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Canonical URL: strip trailing slash when a prerendered page exists.
# Capture path from THE_REQUEST (must use a cond with a capture group).
RewriteCond %{THE_REQUEST} \s/+([^?\s]*?)/\s [NC]
RewriteCond %{DOCUMENT_ROOT}/%1/index.html -f
RewriteRule ^ /%1 [R=301,L]

# Clean URL → prerendered /path/index.html (internal rewrite, no redirect)
RewriteCond %{REQUEST_URI} ^/(.+?)/?$
RewriteCond %{DOCUMENT_ROOT}/%1/index.html -f
RewriteRule ^ %1/index.html [L]

# Unknown paths → real HTTP 404 (ErrorDocument above). Do NOT fall back to index.html.

# Note: /authors/* are real prerendered pages (not WordPress /author/*).
